pub const MOD_SHIFT: i32 = 1
pub const MOD_CTRL:  i32 = 2
pub const MOD_ALT:   i32 = 4
pub const MOD_META:  i32 = 8

pub fn has_shift(mods: i32) -> bool is
    return (mods & 1) != 0
end

pub fn has_ctrl(mods: i32) -> bool is
    return (mods & 2) != 0
end

pub fn has_alt(mods: i32) -> bool is
    return (mods & 4) != 0
end

pub fn has_meta(mods: i32) -> bool is
    return (mods & 8) != 0
end
