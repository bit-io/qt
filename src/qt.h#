;; ── Compatibility facade (qt 0.1 API) ────────────────────────────────────
;; Programs written against 0.1 (`qt::new_button(...)`, `qt::Widget`) keep
;; working: every function below only forwards to the module that owns it.
;; New code should call the modules directly (qt_widgets::new_button, …).

pub type Widget    = qt_types::Widget
pub type Layout    = qt_types::Layout
pub type Event     = qt_types::Event
pub type EventKind = qt_types::EventKind

;; old API: qt::init  →  qt_app::init
pub fn init() is
    qt_app::init()
end

