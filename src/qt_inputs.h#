mod qt_ffi
mod qt_types

;; ── Line edit ────────────────────────────────────────────────────────────

pub fn new_lineedit(placeholder: string) -> qt_types::Widget is
    return qt_types::Widget { handle: qth_lineedit_new(placeholder) }
end

pub fn lineedit_get_text(edit: qt_types::Widget) -> string is
    return qt_ffi::take(qth_lineedit_get_text(edit.handle))
end

pub fn lineedit_set_text(edit: qt_types::Widget, text: string) is
    qth_lineedit_set_text(edit.handle, text)
end

pub fn lineedit_set_placeholder(edit: qt_types::Widget, text: string) is
    qth_lineedit_set_placeholder(edit.handle, text)
end

pub fn lineedit_set_read_only(edit: qt_types::Widget, read_only: bool) is
    qth_lineedit_set_read_only(edit.handle, if read_only then 1 else 0)
end

pub fn lineedit_set_password_mode(edit: qt_types::Widget, is_password: bool) is
    qth_lineedit_set_echo_password(edit.handle, if is_password then 1 else 0)
end

pub fn lineedit_set_max_length(edit: qt_types::Widget, n: i32) is
    qth_lineedit_set_max_length(edit.handle, n)
end

pub fn lineedit_select_all(edit: qt_types::Widget) is
    qth_lineedit_select_all(edit.handle)
end

