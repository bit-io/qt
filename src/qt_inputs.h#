end

;; ── Radio button ─────────────────────────────────────────────────────────
;; Radio buttons that share a parent widget are mutually exclusive.

pub fn new_radio(text: string) -> qt_types::Widget is
    return qt_types::Widget { handle: qth_radio_new(text) }
end

pub fn radio_is_checked(radio: qt_types::Widget) -> bool is
    return qth_radio_is_checked(radio.handle) != 0
end

pub fn radio_set_checked(radio: qt_types::Widget, checked: bool) is
    qth_radio_set_checked(radio.handle, if checked then 1 else 0)
end

