;; Qt itself. This empty block only makes H# add what
;; `pkg-config --static --libs Qt6Widgets` prints (Qt6Widgets, Qt6Gui,
;; Qt6Core …) plus libstdc++, so a single `mod qt` is all a program needs.
extern static [c++, "Qt6Widgets"] is
end

;; ── String ownership ─────────────────────────────────────────────────────

;; Every `string` the library returns is malloc'ed on the C++ side. This
;; copies it into an ordinary H# string and releases the original, so the
;; wrappers neither leak nor hand out memory that is freed under them.
pub fn take(raw: string) -> string is
    let copy: string = string_slice(raw, 0, string_len(raw))
    qth_free_string(raw)
    return copy
end
