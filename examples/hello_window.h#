use "bit -> qt"

fn main() is
    qt_app::init()

    let window:    qt_types::Widget = qt_window::new_window("Witaj, Qt!", 360, 160)
    let container: qt_types::Widget = qt_widgets::new_container()
    let label:     qt_types::Widget = qt_widgets::new_label("Qt6 + H# (" + qt_app::qt_version() + ")")
    qt_widgets::label_set_alignment(label, 1)

    let layout: qt_types::Layout = qt_layout::new_vbox()
    qt_layout::layout_add_widget(layout, label)
    qt_layout::widget_set_layout(container, layout)

    qt_window::window_set_central_widget(window, container)
    qt_window::window_set_auto_close(window, true)
    qt_widgets::show(window)

    let mut keep_going: bool = true
    while keep_going is
        qt_app::process_events()
        let ev = qt_events::poll_event()
        if ev != nil is
            if ev.kind == qt_types::EventKind::WindowClosed is
                keep_going = false
            end
        end
    end
    qt_app::shutdown()
end
